HTTP_ADDR=:8080
SQLITE_PATH=./data/app.db
MIGRATIONS_PATH=./migrations
CORS_ORIGIN=http://localhost:3000

ZARINHUB_BASE_URL=https://zarin-hub.com
ZARINHUB_TIMEOUT=8s

# Bearer token used as: Authorization: Bearer <token>
# If empty, the GUID below is used as the bearer token.
ZARINHUB_TOKEN=

# Provided API credentials (never commit real values)
ZARINHUB_GUID=
ZARINHUB_API_PASSWORD=
